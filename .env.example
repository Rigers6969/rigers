# Copy this file to .env and fill in whichever keys you actually use.
# .env is gitignored - it never gets committed, so your keys stay local.
# studio.py loads .env automatically via env_config.py, so anything set
# here means you never have to paste it into a sidebar again.

# --- Voiceover Generator - script writing ---
# Only needed if you pick "Claude API" instead of "Ollama (local)".
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Media Finder ---
# All three are free to get; leave any of them blank and that source is
# just silently skipped, no error.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Forex bot (forex_bot/) ---
# Free OANDA demo account -> see forex_bot/README.md for where to find these.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
# practice = demo/fake money (default). live = REAL money.
OANDA_ENV=practice
# Real-money trading is blocked unless this says yes. Leave it blank.
FOREX_ALLOW_LIVE=
FOREX_INSTRUMENT=EUR_USD
FOREX_GRANULARITY=H1
# 0.01 = risk 1% of the account per trade. Don't go above 0.02.
FOREX_RISK_PER_TRADE=0.01
FOREX_MAX_DAILY_LOSS=0.03
FOREX_USE_AI=yes
