# Copy this file to .env and fill in whichever keys you actually use.
# .env is gitignored - it never gets committed, so your keys stay local.
# studio.py loads .env automatically via env_config.py, so anything set
# here means you never have to paste it into a sidebar again.

# --- Voiceover Generator - script writing ---
# Only needed if you pick "Claude API" instead of "Ollama (local)".
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Media Finder ---
# All three are free to get; leave any of them blank and that source is
# just silently skipped, no error.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
FLICKR_API_KEY=
