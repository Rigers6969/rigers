# Copy this file to .env and fill in whichever keys you actually use.
# .env is gitignored - it never gets committed, so your keys stay local.
# studio.py loads .env automatically via env_config.py, so anything set
# here means you never have to paste it into a sidebar again.

# --- Voiceover Generator - script writing ---
# Only needed if you pick "Claude API" instead of "Ollama (local)".
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- Media Finder ---
# Pexels, Pixabay, and Unsplash are free to get, no cost even for
# commercial/monetized use. Leave any of them blank and that source is
# just silently skipped, no error.
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Flickr is NOT free like the others - as of 2026, getting an API key at
# all requires a paid Flickr Pro subscription (~$82/year), and using the
# API for a monetized channel additionally needs a separate,
# staff-approved commercial key. Leave this blank unless you already have
# Flickr Pro and want to bother with that - the media finder works fine
# without it, this source just silently skips.
FLICKR_API_KEY=
